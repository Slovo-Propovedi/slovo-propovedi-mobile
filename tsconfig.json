{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "entities/*": ["src/entities/*"],
      "features/*": ["src/features/*"],
      "pages/*": ["src/pages/*"],
      "shared/*": ["src/shared/*"],
      "widgets/*": ["src/widgets/*"]
    },
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.ts", "__mocks__"]
}
