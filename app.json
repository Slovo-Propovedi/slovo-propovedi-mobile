{
  "expo": {
    "name": "Слово.Проповеди",
    "slug": "slovo-istiny-mobile",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "slovo-istiny",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f16031"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.egoreast.slovoistinymobile",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f16031"
      },
      "package": "com.egoreast.slovoistinymobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.jpg",
      "bundler": "metro"
    },
    "plugins": [["expo-audio", { "enableBackgroundPlayback": true }], "expo-asset", "expo-router"],
    "updates": {
      "enabled": false
    }
  }
}
