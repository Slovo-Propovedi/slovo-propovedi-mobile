# Copy to .env for local development overrides.
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time by Expo/Metro
# (babel-preset-expo). Production builds do NOT read this file: the release
# workflow (.forgejo/workflows/release.yml) injects the EXPO_PUBLIC_* values
# into both its `web` and `android` jobs from Forgejo Actions `vars`.
#
# Bare hostnames only (no protocol, no path, no trailing slash) — same shape
# and same values as the org's Forgejo Actions variables of the same name
# (BACKEND_API_HOSTNAME, LANDING_HOSTNAME, WEB_HOSTNAME), just EXPO_PUBLIC_-
# prefixed so Expo/Metro inlines them into the app bundle. The code builds
# the full URL from these.
#
# The three EXPO_PUBLIC_* vars below are REQUIRED: they are validated with zod
# in src/shared/config/env.ts and have NO defaults, so a missing value fails
# fast at build/bundle time instead of shipping a broken URL. app.config.ts also
# reads EXPO_PUBLIC_WEB_HOSTNAME to generate the Android App Links host.
# For local development copy this file to .env; CI injects the real values
# (see .forgejo/workflows/release.yml). In production releases all of the
# below come from Forgejo org/repo-level `vars` (same names, minus the
# EXPO_PUBLIC_ prefix) — they must be configured there before tagging.
EXPO_PUBLIC_BACKEND_API_HOSTNAME=api.slovo-propovedi.ru
EXPO_PUBLIC_LANDING_HOSTNAME=slovo-propovedi.ru
EXPO_PUBLIC_WEB_HOSTNAME=app.slovo-propovedi.ru

# Self-hosted OTA (expo-updates → xprem), read by ota.config.ts at Expo config
# evaluation time (Node only — never bundled into the app JS). ALL FOUR are
# all-or-nothing: leave any of them empty and the build gets `updates.enabled:
# false` and never self-updates (safe for F-Droid / arbitrary local builds).
# CI reads the same names from Forgejo org/repo `vars`.
# Manifest URL served by the xprem server.
EXPO_PUBLIC_OTA_URL=https://ota.example.com/api/manifest
# Application id from the xprem dashboard.
EXPO_PUBLIC_XPREM_APP_ID=CHANGE-ME-xprem-app-id
# xprem channel the app requests manifests from.
EXPO_PUBLIC_XPREM_CHANNEL_NAME=production
# xprem branch `eoas publish` targets (must match the channel).
EXPO_PUBLIC_XPREM_BRANCH_NAME=production

# DOCS_HOSTNAME is read by orval.config.ts (plain Node script, not bundled
# into the app) when generating the API client from the OpenAPI spec. It has
# NO fallback: orval fails if it is unset.
DOCS_HOSTNAME=docs.slovo-propovedi.ru

# Local release-build signing (debug keystore; see docs/BUILD-LOCAL.md).
# CI uses ANDROID_KEYSTORE_* secrets instead. Values below are the public debug key.
# RELEASE_STORE_FILE — путь к keystore относительно android/app или абсолютный.
# RELEASE_STORE_FILE=debug.keystore
# RELEASE_STORE_PASSWORD=android
# RELEASE_KEY_ALIAS=androiddebugkey
# RELEASE_KEY_PASSWORD=android
