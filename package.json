{
  "name": "slovo-propovedi-mobile",
  "version": "0.31.1",
  "main": "expo-router/entry",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "api:generate": "yarn delete-generated-api-files && NODE_OPTIONS=--no-network-family-autoselection orval",
    "build-local-debug:android": "cd android && ./gradlew assembleDevDebug",
    "build-local-release:android": "cd android && ./gradlew assembleProdRelease",
    "check:fsd": "steiger .",
    "check:fsd-watch": "steiger . --watch",
    "check:circular": "depcruise src --config .dependency-cruiser.cjs",
    "check:patches": "node scripts/check-patches.mjs",
    "check:types": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "check:sw": "tsc --noEmit -p tsconfig.sw.json",
    "check:types-open": "editor=$(printf 'nvim\\nnvim --remote-silent\\ncode -r' | fzf --prompt='Select editor: ') && files=($(tsc -p tsconfig.json 2>&1 | grep -oE '[^ (]+.tsx?' | sort -u)) && if [ ${#files[@]} -gt 0 ]; then $editor \"${files[@]}\"; else echo 'No files with errors found'; fi",
    "check:types-open-windows": "tsc -p tsconfig.json 2>&1 | grep -oE '[^ (]+.tsx?' | sort -u | xargs code",
    "check:unused": "knip",
    "commitlint": "commitlint --edit $1",
    "delete-generated-api-files": "del-cli \"src/shared/api/generated/*\" \"!src/shared/api/generated/index.ts\"",
    "dev:launch": "adb reverse tcp:8081 tcp:8081 && adb shell am force-stop ru.slovopropovedi.dev && adb shell am start -n ru.slovopropovedi.dev/ru.slovopropovedi.MainActivity",
    "lint": "eslint . --concurrency=off",
    "lint-staged": "npx lint-staged",
    "lint:fix": "eslint . --fix --concurrency=off",
    "lint:staged": "lint-staged",
    "postinstall": "patch-package",
    "prepare": "husky",
    "prettier:write": "prettier --write **/*.{js,ts,tsx,json}",
    "run:android": "expo run:android --variant devDebug",
    "run:android:prod": "expo run:android --variant prodDebug",
    "run:ios": "expo run:ios",
    "start": "expo start",
    "web": "EXPO_NO_METRO_LAZY=1 expo start --web",
    "web:build": "expo export -p web && node scripts/inject-sw-precache.mjs",
    "web:preview": "yarn web:build && yarn serve -s dist -l 4173",
    "test": "jest --watch --coverage=false --changedSince=origin/main",
    "testDebug": "jest -o --watch --coverage=false",
    "test:native": "cd android && ./gradlew :apk-installer:testDebugUnitTest :audio-effects:testDebugUnitTest --continue",
    "testFinal": "jest",
    "testFinal:all": "yarn testFinal && yarn test:native",
    "updateSnapshots": "jest -u --coverage=false",
    "bump-version": "node scripts/bump-version.mjs",
    "version-major": "yarn version --major",
    "version-minor": "yarn version --minor",
    "version-patch": "yarn version --patch",
    "visualize-deps": "npx fsd-cruise"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@reatom/framework": "^3.4.68",
    "@reatom/npm-react": "^3.10.6",
    "@types/jest": "30.0.0",
    "apk-installer": "file:./modules/apk-installer",
    "audio-effects": "file:./modules/audio-effects",
    "axios": "^1.20.0",
    "debounce": "^3.0.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-checkbox": "~58.0.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "jest": "~30.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^9.5.3",
    "ts-pattern": "^5.9.2",
    "typescript": "~6.0.3",
    "uuid": "^14",
    "xml-js": "^1.6.11",
    "youtubei.js": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "del-cli": "^8.0.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-hooks-extra": "^2.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest-expo": "~58.0.12",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "orval": "8.44.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "react-native-web": "^0.21.4",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "steiger": "^0.8.0",
    "test-renderer": "1.3.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "8.72.0"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    }
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "resolutions": {
    "punycode": "2.3.1"
  },
  "worklets": {
    "staticFeatureFlags": {
      "ENABLE_CROSS_RUNTIME_STACK_TRACES": false
    }
  }
}
