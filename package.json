{
  "name": "slovo-propovedi-mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "license": "MIT",
  "scripts": {
    "api:generate": "yarn delete-generated-api-files && orval",
    "build-local-debug:android": "cd android && ./gradlew assembleDebug",
    "build-local-release:android": "cd android && ./gradlew assembleRelease",
    "build-preview:all": "eas build -p all --profile preview",
    "build-preview:android": "eas build -p android --profile preview",
    "build-preview:ios": "eas build -p ios --profile preview",
    "build:all": "eas build --platform all",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:list": "eas build:list",
    "check:fsd": "steiger ./src",
    "check:fsd-watch": "steiger ./src --watch",
    "check:types": "tsc -p tsconfig.json",
    "check:types-open": "editor=$(printf 'nvim\\nnvim --remote-silent\\ncode -r' | fzf --prompt='Select editor: ') && files=($(tsc -p tsconfig.json 2>&1 | grep -oE '[^ (]+.tsx?' | sort -u)) && if [ ${#files[@]} -gt 0 ]; then $editor \"${files[@]}\"; else echo 'No files with errors found'; fi",
    "check:types-open-windows": "tsc -p tsconfig.json 2>&1 | grep -oE '[^ (]+.tsx?' | sort -u | xargs code",
    "check:unused": "knip --include-libs",
    "commitlint": "commitlint --edit $1",
    "delete-generated-api-files": "del-cli \"src/shared/api/generated/*\" \"!src/shared/api/generated/index.ts\"",
    "emulator-run-builds": "eas build:run -p android",
    "lint": "eslint .",
    "lint-staged": "npx lint-staged",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "postinstall": "patch-package",
    "prepare": "husky",
    "prettier:write": "prettier --write **/*.{js,ts,tsx,json}",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "start": "expo start",
    "test": "jest --watch --coverage=false --changedSince=origin/main",
    "testDebug": "jest -o --watch --coverage=false",
    "testFinal": "jest",
    "update-app": "eas update --branch main --message \"Updating the app\"",
    "updateSnapshots": "jest -u --coverage=false",
    "version-major": "yarn version --major",
    "version-minor": "yarn version --minor",
    "version-patch": "yarn version --patch",
    "visualize-deps": "npx fsd-cruise"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reatom/core": "^1001.1.0",
    "@reatom/framework": "^3.4.68",
    "@reatom/npm-react": "^3.10.6",
    "@types/jest": "29.5.14",
    "axios": "^1.18.1",
    "debounce": "^3.0.0",
    "expo": "~57.0.4",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "^57.0.0",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-intent-launcher": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "^57.0.3",
    "expo-router": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.2",
    "expo-updates": "~57.0.6",
    "jest": "~29.7.0",
    "msw": "^2.14.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-tab-view": "^4.3.1",
    "react-native-text-ticker": "^1.16.0",
    "react-native-worklets": "0.10.0",
    "ts-pattern": "^5.9.0",
    "typescript": "^6.0.3",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@expo/webpack-config": "^19.0.1",
    "@faker-js/faker": "^10.5.0",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "~19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "del-cli": "^7.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.0.11",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-hooks-extra": "^2.13.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest-expo": "~57.0.1",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "orval": "8.20.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.4",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "steiger": "^0.5.13",
    "test-renderer": "1.2.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "8.62.2-alpha.8"
  },
  "private": true,
  "resolutions": {
    "punycode": "2.3.1"
  }
}
