#!/usr/bin/env sh

# Husky commit-msg hook: DCO auto-sign + commitlint validation.
# Runs after the editor saves the commit message; receives the message
# file path as $1. Bypass with --no-verify.

# 1. DCO auto-sign: ensure Signed-off-by trailer with proper format.
# Strips any existing Signed-off-by lines (may be malformed) and re-adds
# with correct blank-line separator required by git trailer format.
# Works with any git client (lazygit, VS Code, CLI, IDEs).
# Must run before commitlint, since commitlint's signed-off-by rule
# rejects messages that don't already carry the trailer.

MSG_FILE="$1"
NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  echo "❌ Cannot add Signed-off-by: git user.name or user.email not configured."
  echo "   Fix with:"
  echo "     git config user.name 'Your Name'"
  echo "     git config user.email 'your.email@example.com'"
  exit 1
fi

# Strip any existing Signed-off-by lines (user may have added them manually
# without proper blank-line separator, which fails DCO on the server).
sed -i '/^Signed-off-by:/d' "$MSG_FILE"

# Remove trailing blank lines and ensure exactly one trailing newline.
# sed '/^$/d' removes ALL blank lines which is too aggressive — we only
# want to clean up trailing whitespace. Use perl for portability.
# \n* matches zero-or-more so a message with NO trailing newline still
# ends up with exactly one before the blank-line separator is added.
perl -i -p0e 's/\n*$/\n/' "$MSG_FILE"

# Add blank line separator + Signed-off-by trailer.
echo "" >> "$MSG_FILE"
echo "Signed-off-by: $NAME <$EMAIL>" >> "$MSG_FILE"

# 2. Validate conventional-commit format + signed-off-by trailer.
yarn commitlint --edit "$1" || exit 1
